dst="/mnt/external/Recovered"

mkdir -p "$dst"/{markdown_probable,txt_personal}

find /mnt/externo/recup_dir* -name "*.txt" | while read file; do
    # Discard very small files
    size=$(wc -c < "$file")
    if [ "$size" -lt 200 ]; then continue; fi

    # Discard system files by typical keywords
    if grep -qiE "^(Package:|License:|Copyright|Permission is hereby|GNU General|MIT License|Maintainer:|Version:|Description:)" "$file" 2>/dev/null; then
        continue
    fi

    # Markdown detection score
    md_score=0
    grep -qE "^#{1,6} "     "$file" && md_score=$((md_score + 3))
    grep -qE "^[-*] "        "$file" && md_score=$((md_score + 2))
    grep -qE "\*\*.+\*\*"   "$file" && md_score=$((md_score + 1))
    grep -qE "^\`\`\`"       "$file" && md_score=$((md_score + 2))
    grep -qE "\[.+\]\(.+\)" "$file" && md_score=$((md_score + 2))

    if [ "$md_score" -ge 3 ]; then
        cp "$file" "$dst"/markdown_probable/
    else
        cp "$file" "$dst"/txt_personal/
    fi
done
